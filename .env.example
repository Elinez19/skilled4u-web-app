# ==============================================================================
# Skilled4U Environment Variables Template
# Copy this file to .env and supply the active environment secrets
# ==============================================================================

# Database (Neon Serverless PostgreSQL with PostGIS extension)
DATABASE_URL="postgres://skilled4u_owner:your_neon_password@ep-cool-fog-123456.us-east-2.aws.neon.tech/skilled4u?sslmode=require"

# Bachs Connect (https://bachs.io - Marketplace Payments & Escrow Transfers)
# Money Standard: Always decimal string representation ("5000.00"), never minor units
BACHS_API_KEY="sk_live_your_bachs_secret_key"
BACHS_WEBHOOK_SECRET="whsec_your_bachs_webhook_signature_secret"
PLATFORM_COMMISSION_PERCENT="12"
DEFAULT_CURRENCY="NGN"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="your_32_character_random_hex_secret_here"
BETTER_AUTH_URL="http://localhost:3000"

# Cloudinary (Direct Pre-Signed Uploads for IDs, Proof-of-Work, Receipts)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Real-Time WebSocket Channel (Pusher / Supabase Realtime)
REALTIME_APP_ID="your_realtime_app_id"
REALTIME_KEY="your_realtime_key"
REALTIME_SECRET="your_realtime_secret"
REALTIME_CLUSTER="mt1"

# Mobile Public Envs (Accessible in Expo SDK 58 React Native)
EXPO_PUBLIC_API_URL="http://192.168.1.100:3000"
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN="pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuIn0"
EXPO_PUBLIC_REALTIME_KEY="your_realtime_key"
EXPO_PUBLIC_REALTIME_CLUSTER="mt1"

# AI Fault Triage Helper (SkilledAI)
GEMINI_API_KEY="your_gemini_api_key"

# Observability (Sentry)
SENTRY_DSN=""
